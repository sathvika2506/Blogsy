<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Forgot Password — Blogsy</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="/style.css" rel="stylesheet" />
</head>
<body>
  <%- include('partials/navbar') %>
  <div class="container">
    <div class="form-page">
      <div class="text-center mb-4">
        <h2>Reset Password 🔑</h2>
        <p class="form-subtitle">Enter your email to receive a reset link</p>
      </div>
      <% if (error) { %><div class="alert-warm-error"><%= error %></div><% } %>
      <% if (success) { %><div class="alert-warm-success"><%= success %></div><% } %>
      <form action="/forgot-password" method="POST">
        <div class="mb-3">
          <label for="email" class="form-label">Email Address</label>
          <input type="email" id="email" name="email" class="form-control" placeholder="your@email.com" required />
        </div>
        <button type="submit" class="btn-primary-warm w-100 py-2" style="border-radius:var(--radius-sm);">Send Reset Link</button>
      </form>
      <div class="text-center mt-3">
        <a href="/login" style="font-size:0.85rem; color:var(--text-muted);">← Back to Login</a>
      </div>
    </div>
  </div>
  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
