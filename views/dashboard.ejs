<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard — Blogsy</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="/style.css" rel="stylesheet" />
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
      <h2 class="section-heading" style="margin:0;">Dashboard</h2>
      <div class="d-flex gap-2 mt-2 mt-md-0">
        <a href="/profile/edit" class="btn-outline-warm">Edit Profile</a>
        <a href="/compose" class="btn-primary-warm">Write New Post</a>
      </div>
    </div>

    <!-- Stats Grid -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-num"><%= posts.length %></div>
        <div class="stat-label">TOTAL POSTS</div>
      </div>
      <div class="stat-card">
        <div class="stat-num"><%= totals.views %></div>
        <div class="stat-label">TOTAL VIEWS</div>
      </div>
      <div class="stat-card">
        <div class="stat-num"><%= totals.likes + totals.comments %></div>
        <div class="stat-label">ENGAGEMENTS</div>
      </div>
    </div>

    <div class="row">
      <!-- Your Posts -->
      <div class="col-lg-8">
        <h4 style="font-family:'Playfair Display',serif;margin-bottom:1rem;">Your Stories</h4>
        
        <% if (posts.length === 0) { %>
          <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-md);padding:3rem;text-align:center;">
            <p style="font-size:3rem;margin-bottom:0.5rem;">📝</p>
            <p class="text-muted">You haven't written any stories yet.</p>
            <a href="/compose" class="btn-primary-warm mt-2">Start Writing</a>
          </div>
        <% } %>

        <% posts.forEach(post => { %>
          <div class="dash-post-row">
            <div class="dash-post-title">
              <a href="/posts/<%= post.id %>" style="color:inherit;"><%= post.title %></a>
            </div>
            <% if (post.status === 'published') { %>
              <span class="status-badge status-published">Published</span>
            <% } else { %>
              <span class="status-badge status-draft">Draft</span>
            <% } %>
            <div class="d-flex gap-3 ms-2 text-muted" style="font-size:0.8rem;">
              <span title="Views">👁 <%= post.views || 0 %></span>
              <span title="Likes">❤️ <%= post.like_count || 0 %></span>
              <span title="Comments">💬 <%= post.comment_count || 0 %></span>
            </div>
            <div class="ms-3 d-flex gap-2">
              <a href="/posts/<%= post.id %>/edit" class="btn-ghost" style="padding:0.2rem 0.5rem;">Edit</a>
            </div>
          </div>
        <% }) %>
      </div>

      <!-- Notifications -->
      <div class="col-lg-4 mt-4 mt-lg-0">
        <h4 style="font-family:'Playfair Display',serif;margin-bottom:1rem;">Notifications</h4>
        
        <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-md);padding:1rem;">
          <% if (notifications.length === 0) { %>
            <p class="text-muted mb-0" style="font-size:0.85rem;text-align:center;padding:1rem 0;">You're all caught up!</p>
          <% } %>
          
          <% notifications.forEach(n => { %>
            <div class="notif-item">
              <% if (!n.read) { %><div class="notif-dot"></div><% } %>
              <div style="flex-grow:1;">
                <span style="font-weight:600;color:var(--text-dark);"><%= n.from_name %></span>
                <% if (n.type === 'like') { %> liked <% } else { %> commented on <% } %>
                <a href="/posts/<%= n.post_id %>" style="font-weight:500;">"<%= n.post_title %>"</a>
                <div style="font-size:0.75rem;color:var(--text-muted);margin-top:2px;">
                  <%= new Date(n.created_at).toLocaleDateString() %>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
