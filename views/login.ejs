<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login — Blogsy</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="/style.css" rel="stylesheet" />
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container">
    <div class="form-page">
      <div class="text-center mb-4">
        <h2>Welcome Back 🌸</h2>
        <p class="form-subtitle">Sign in to your Blogsy account</p>
      </div>

      <% if (error) { %>
        <div class="alert-warm-error"><%= error %></div>
      <% } %>
      <% if (success) { %>
        <div class="alert-warm-success"><%= success %></div>
      <% } %>

      <form action="/login" method="POST">
        <div class="mb-3">
          <label for="email" class="form-label">Email</label>
          <input type="email" id="email" name="email" class="form-control" placeholder="your@email.com" required />
        </div>
        <div class="mb-3">
          <label for="password" class="form-label">Password</label>
          <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" required />
          <div class="text-end mt-1">
            <a href="/forgot-password" style="font-size:0.82rem; color:var(--text-muted);">Forgot password?</a>
          </div>
        </div>
        <button type="submit" class="btn-primary-warm w-100 py-2 mt-2" style="border-radius:var(--radius-sm);">Sign In</button>
      </form>

      <div class="text-center mt-4" style="font-size:0.88rem; color:var(--text-muted);">
        Don't have an account? <a href="/register" style="font-weight:600; color:var(--primary);">Create one</a>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
