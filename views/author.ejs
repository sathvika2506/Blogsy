<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= author.name %>'s Profile — Blogsy</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="/style.css" rel="stylesheet" />
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container mt-4">
    <!-- Author Hero -->
    <div class="profile-hero">
      <% if (author.avatar_url) { %>
        <img src="<%= author.avatar_url %>" alt="<%= author.name %>" class="profile-avatar">
      <% } else { %>
        <div class="profile-avatar-placeholder"><%= author.name.charAt(0) %></div>
      <% } %>
      <h1 style="font-family:'Playfair Display',serif;color:var(--text-dark);"><%= author.name %></h1>
      <p style="color:var(--text-mid);max-width:500px;margin:0.5rem auto 1rem;"><%= author.bio || 'This author has not added a bio yet.' %></p>
      
      <div class="social-links">
        <% if (author.website) { %><a href="<%= author.website %>" target="_blank" title="Website">🌐</a><% } %>
        <% if (author.twitter) { %><a href="https://twitter.com/<%= author.twitter %>" target="_blank" title="Twitter">🐦</a><% } %>
        <% if (author.instagram) { %><a href="https://instagram.com/<%= author.instagram %>" target="_blank" title="Instagram">📸</a><% } %>
      </div>
      <div class="mt-3" style="font-size:0.8rem;color:var(--text-muted);">
        Joined <%= new Date(author.created_at).toLocaleDateString('en-US',{month:'long',year:'numeric'}) %>
      </div>
    </div>

    <!-- Author's Posts -->
    <h3 class="section-heading">Stories by <%= author.name.split(' ')[0] %></h3>
    
    <% if (posts.length === 0) { %>
      <div class="text-center py-5">
        <p class="text-muted">No published stories yet.</p>
      </div>
    <% } else { %>
      <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
        <% posts.forEach(post => { %>
          <div class="col">
            <div class="blog-card">
              <% if (post.cover_image) { %>
                <img src="<%= post.cover_image %>" class="card-cover" alt="<%= post.title %>">
              <% } %>
              <div class="card-body">
                <% if (post.tags && post.tags.length > 0) { %>
                  <div class="mb-2">
                    <% post.tags.slice(0, 2).forEach(tag => { %>
                      <a href="/search?tag=<%= tag %>" class="tag-badge me-1"><%= tag %></a>
                    <% }) %>
                  </div>
                <% } %>
                <h5 class="card-title">
                  <a href="/posts/<%= post.id %>" style="color:inherit;"><%= post.title %></a>
                </h5>
                <p class="card-excerpt"><%= post.content.replace(/[#*`>]/g, '').slice(0, 110) %>...</p>
                <div class="card-footer-custom mt-auto">
                  <span class="post-date-sm"><%= new Date(post.created_at).toLocaleDateString() %></span>
                  <div class="d-flex gap-2">
                    <span class="stat-badge">❤️ <%= post.like_count || 0 %></span>
                    <a href="/posts/<%= post.id %>" class="btn-sm-warm">Read</a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
