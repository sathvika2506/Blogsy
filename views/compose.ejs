<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Write a Story — Blogsy</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="/style.css" rel="stylesheet" />
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container">
    <div class="compose-page">
      <h2 style="font-size:1.8rem; margin-bottom:0.25rem;">✍️ Write Your Story</h2>
      <p style="color:var(--text-muted);font-size:0.9rem;margin-bottom:1.5rem;">Share your thoughts with the world</p>

      <% if (error) { %><div class="alert-warm-error"><%= error %></div><% } %>

      <form action="/compose" method="POST" id="composeForm">

        <div class="mb-3">
          <label for="postTitle" class="form-label">Title</label>
          <div class="d-flex gap-2">
            <input type="text" id="postTitle" name="postTitle" class="form-control"
              placeholder="Give your story a beautiful title..." required
              value="<%= draft ? draft.postTitle : '' %>" />
            <button type="button" class="ai-btn" onclick="generateTitles()" title="AI Title Suggestions">✨ Suggest</button>
          </div>
          <div id="titles-result" class="ai-result" style="display:none;"></div>
        </div>

        <div class="mb-3">
          <label for="cover_image" class="form-label">Cover Image URL <span style="font-weight:400;color:var(--text-muted)">(optional)</span></label>
          <input type="url" id="cover_image" name="cover_image" class="form-control" placeholder="https://..." />
        </div>

        <div class="mb-3">
          <label for="postBody" class="form-label">Content <span style="font-weight:400;color:var(--text-muted)">(Markdown supported)</span></label>
          <!-- Toolbar -->
          <div class="editor-toolbar">
            <button type="button" onclick="wrap('**','**')" title="Bold"><b>B</b></button>
            <button type="button" onclick="wrap('*','*')" title="Italic"><i>I</i></button>
            <button type="button" onclick="wrap('# ','')" title="Heading 1">H1</button>
            <button type="button" onclick="wrap('## ','')" title="Heading 2">H2</button>
            <button type="button" onclick="wrap('### ','')" title="Heading 3">H3</button>
            <button type="button" onclick="wrap('> ','')" title="Blockquote">❝</button>
            <button type="button" onclick="wrap('`','`')" title="Inline code">{'`'}</button>
            <button type="button" onclick="wrap('\n```\n','\n```')" title="Code block">{'```'}</button>
            <button type="button" onclick="wrap('[','](url)')" title="Link">🔗</button>
            <button type="button" onclick="wrap('![alt](',')') " title="Image">🖼</button>
            <button type="button" onclick="insertList()" title="List">• List</button>
          </div>
          <textarea id="postBody" name="postBody" class="form-control with-toolbar"
            rows="14" placeholder="Write something beautiful... (Markdown supported)" required><%= draft ? draft.postBody : '' %></textarea>
        </div>

        <div class="mb-3">
          <label for="tags" class="form-label">Tags <span style="font-weight:400;color:var(--text-muted)">(comma-separated)</span></label>
          <div class="d-flex gap-2">
            <input type="text" id="tags" name="tags" class="form-control" placeholder="lifestyle, travel, fashion" />
            <button type="button" class="ai-btn" onclick="generateTags()">🏷 Auto-tag</button>
          </div>
        </div>

        <!-- AI Panel -->
        <div class="ai-panel">
          <h6>✨ AI Writing Tools</h6>
          <div class="d-flex flex-wrap gap-2 mb-2">
            <button type="button" class="ai-btn" onclick="generateSummary()">📝 Generate Summary</button>
            <button type="button" class="ai-btn" onclick="improveContent()">🪄 Improve Writing</button>
            <button type="button" class="ai-btn" onclick="generateTitles()">💡 Title Ideas</button>
          </div>
          <span class="ai-loading" id="ai-loading">✨ AI is thinking...</span>
          <div id="ai-main-result" class="ai-result" style="display:none;"></div>
        </div>

        <div class="mb-3 mt-3">
          <label class="form-label">Publish Status</label>
          <div class="d-flex gap-3">
            <label style="font-size:0.88rem;cursor:pointer;">
              <input type="radio" name="status" value="published" checked /> Publish Now
            </label>
            <label style="font-size:0.88rem;cursor:pointer;">
              <input type="radio" name="status" value="draft" /> Save as Draft
            </label>
          </div>
        </div>

        <div class="d-flex gap-3 mt-4">
          <button type="submit" class="btn-primary-warm py-2" style="border-radius:var(--radius-sm);flex:1;">Publish Story</button>
          <a href="/" class="btn-outline-warm py-2" style="border-radius:var(--radius-sm);">Cancel</a>
        </div>
      </form>
    </div>
  </div>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function wrap(before, after) {
      const ta = document.getElementById('postBody');
      const start = ta.selectionStart, end = ta.selectionEnd;
      const selected = ta.value.substring(start, end);
      ta.value = ta.value.substring(0, start) + before + selected + after + ta.value.substring(end);
      ta.focus();
      ta.selectionStart = start + before.length;
      ta.selectionEnd = end + before.length;
    }
    function insertList() {
      const ta = document.getElementById('postBody');
      const lines = ta.value.substring(ta.selectionStart, ta.selectionEnd).split('\n').map(l => '- ' + l).join('\n');
      wrap('', '');
      ta.setRangeText(lines.length > 2 ? lines : '- Item 1\n- Item 2\n- Item 3');
    }

    function showLoading() {
      document.getElementById('ai-loading').style.display = 'block';
      document.getElementById('ai-main-result').style.display = 'none';
    }
    function showResult(text) {
      document.getElementById('ai-loading').style.display = 'none';
      const el = document.getElementById('ai-main-result');
      el.style.display = 'block';
      el.textContent = text;
    }

    async function generateSummary() {
      const content = document.getElementById('postBody').value;
      if (!content.trim()) return alert('Please write some content first.');
      showLoading();
      const res = await fetch('/ai/summary', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ content })
      });
      const data = await res.json();
      showResult('📝 Summary:\n' + data.result);
    }

    async function generateTags() {
      const title = document.getElementById('postTitle').value;
      const content = document.getElementById('postBody').value;
      if (!content.trim()) return alert('Please write some content first.');
      showLoading();
      const res = await fetch('/ai/tags', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ title, content })
      });
      const data = await res.json();
      document.getElementById('tags').value = data.result;
      document.getElementById('ai-loading').style.display = 'none';
    }

    async function improveContent() {
      const content = document.getElementById('postBody').value;
      if (!content.trim()) return alert('Please write some content first.');
      if (!confirm('Replace your current content with AI-improved version?')) return;
      showLoading();
      const res = await fetch('/ai/improve', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ content })
      });
      const data = await res.json();
      document.getElementById('postBody').value = data.result;
      document.getElementById('ai-loading').style.display = 'none';
      showResult('✅ Content improved! Review the changes above.');
    }

    async function generateTitles() {
      const content = document.getElementById('postBody').value;
      showLoading();
      const res = await fetch('/ai/titles', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ content })
      });
      const data = await res.json();
      const titlesEl = document.getElementById('titles-result');
      titlesEl.style.display = 'block';
      titlesEl.textContent = data.result;
      document.getElementById('ai-loading').style.display = 'none';
    }
  </script>
</body>
</html>