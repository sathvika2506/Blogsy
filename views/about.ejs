<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>About Blogsy</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="/style.css" rel="stylesheet" />
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container mt-5">
    <div style="max-width:800px; margin:0 auto; text-align:center;">
      <h2 class="section-heading justify-content-center mb-4">About Blogsy</h2>
      
      <img src="/journalling.jpg" class="d-block w-100 mb-4" alt="journalling" style="border-radius:var(--radius-lg); box-shadow:var(--shadow-md);" />
      
      <div style="font-size:1.1rem; color:var(--text-dark); line-height:1.9;">
        <p>
          <strong>Blogsy</strong> is your cozy corner of the internet where stories, creativity, and inspiration meet.
        </p>
        <p>
          Whether you're here for fashion, travel, lifestyle, or personal reflections, our goal is to make blogging feel
          warm and personal — just like a handwritten journal. 
        </p>
        <p>
          Grab a cup of tea, find a comfortable spot, and let the stories take you away.
        </p>
      </div>

      <div class="mt-5 mb-5">
        <% if (!currentUser) { %>
          <a href="/register" class="btn-primary-warm px-4 py-2" style="font-size:1rem;">Start Writing With Us</a>
        <% } %>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>