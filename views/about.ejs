        <p class="mb-1">© <%= new Date().getFullYear() %> Blogsy — All rights reserved.</p>
        <p class="mb-0">
          Made by
          <a href="https://yourportfolio.com" class="text-decoration-none text-dark fw-semibold">Sathvika</a>
        </p>
      </div>
    </footer>
