<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous" />
  <link href="/style.css" rel="stylesheet" />
  <title>Blogsy</title>
</head>

<body>
  <!--navbar-->
  <nav class="navbar navbar-expand-lg custom-navbar shadow-sm py-3">
    <div class="container-fluid">
      <a class="navbar-brand fs-3 fw-bold text-dark me-4" href="#">Blogsy</a>

      <form class="d-flex me-auto" role="search" method="GET" action="/search" style="width: 35%;">
        <input class="form-control me-2" type="search" name="query" placeholder="Search posts..." aria-label="Search" />
        <button type="submit" class="btn btn-light">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search"
            viewBox="0 0 16 16">
            <path
              d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
          </svg>
        </button>
      </form>


      <ul class="navbar-nav mb-2 mb-lg-0 d-flex flex-row gap-3 me-3">
        <li class="nav-item">
          <a class="nav-link active" href="/"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
              fill="currentColor" class="bi bi-house-heart" viewBox="0 0 16 16">
              <path d="M8 6.982C9.664 5.309 13.825 8.236 8 12 2.175 8.236 6.336 5.309 8 6.982" />
              <path
                d="M8.707 1.5a1 1 0 0 0-1.414 0L.646 8.146a.5.5 0 0 0 .708.707L2 8.207V13.5A1.5 1.5 0 0 0 3.5 15h9a1.5 1.5 0 0 0 1.5-1.5V8.207l.646.646a.5.5 0 0 0 .708-.707L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293zM13 7.207V13.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V7.207l5-5z" />
            </svg>Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/compose"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
              fill="currentColor" class="bi bi-plus-square" viewBox="0 0 16 16">
              <path
                d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2z" />
              <path
                d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4" />
            </svg>Compose</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/about"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
              fill="currentColor" class="bi bi-info-circle-fill" viewBox="0 0 16 16">
              <path
                d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2" />
            </svg>About</a>
        </li>
      </ul>
    </div>
  </nav>
  <div class="container mt-5">
    <h2>Search Results for "<%= searchQuery %>"</h2>

    <% if (posts.length===0) { %>
      <p>No posts found.</p>
      <% } else { %>
        <div class="row">
          <% posts.forEach(post=> { %>
            <div class="col-md-6 mb-4">
              <div class="card">
                <div class="card-body">
                  <h4 class="card-title">
                    <%= post.title %>
                  </h4>
                  <p class="card-text">
                    <%= post.content.substring(0, 100) %>...
                  </p>
                  <a href="/posts/<%= post.id %>" class="btn btn-primary">Read More</a>
                </div>
              </div>
            </div>
            <% }) %>
        </div>
        <% } %>
  </div>
  <footer class="footer mt-5 py-4 text-center text-muted">
    <div class="container">
      <p class="mb-1">© <%= new Date().getFullYear() %> Blogsy — All rights reserved.</p>
      <p class="mb-0">
        Made by <a href="https://yourportfolio.com" class="text-decoration-none text-dark fw-semibold">Sathvika</a>
      </p>
    </div>
  </footer>




  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q"
    crossorigin="anonymous"></script>
</body>

</html>