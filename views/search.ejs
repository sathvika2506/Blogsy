<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Search: <%= searchQuery %> — Blogsy</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="/style.css" rel="stylesheet" />
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container mt-5">
    <div style="background:var(--primary-l);border-radius:var(--radius-lg);padding:2rem;margin-bottom:2rem;text-align:center;">
      <% if (isTag) { %>
        <span class="tag-badge" style="font-size:1rem;padding:0.4rem 1rem;margin-bottom:0.5rem;display:inline-block;">🏷 <%= searchQuery %></span>
        <h2 style="font-family:'Playfair Display',serif;margin:0;">Stories tagged with "<%= searchQuery %>"</h2>
      <% } else { %>
        <h2 style="font-family:'Playfair Display',serif;margin:0;">Search Results for "<%= searchQuery %>"</h2>
      <% } %>
      <p style="color:var(--text-mid);margin-top:0.5rem;margin-bottom:0;">Found <%= posts.length %> <%= posts.length === 1 ? 'story' : 'stories' %></p>
    </div>

    <% if (posts.length === 0) { %>
      <div class="text-center py-5">
        <p style="font-size:3rem;">🔍</p>
        <h4>No stories found</h4>
        <p class="text-muted">Try a different search term or explore our homepage.</p>
        <a href="/" class="btn-primary-warm mt-2">Go to Home</a>
      </div>
    <% } else { %>
      <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
        <% posts.forEach(post => { %>
          <div class="col">
            <div class="blog-card">
              <% if (post.cover_image) { %>
                <img src="<%= post.cover_image %>" class="card-cover" alt="<%= post.title %>">
              <% } %>
              <div class="card-body">
                <% if (post.tags && post.tags.length > 0) { %>
                  <div class="mb-2">
                    <% post.tags.slice(0, 2).forEach(tag => { %>
                      <a href="/search?tag=<%= tag %>" class="tag-badge me-1"><%= tag %></a>
                    <% }) %>
                  </div>
                <% } %>
                <h5 class="card-title">
                  <a href="/posts/<%= post.id %>" style="color:inherit;"><%= post.title %></a>
                </h5>
                <p class="card-excerpt"><%= post.content.replace(/[#*`>]/g, '').slice(0, 110) %>...</p>
                <div class="card-footer-custom mt-auto">
                  <span class="author-name-sm"><%= post.author_name || 'Anonymous' %></span>
                  <a href="/posts/<%= post.id %>" class="btn-sm-warm">Read</a>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>