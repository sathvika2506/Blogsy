<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous" />
  <link href="/style.css" rel="stylesheet" />
  <title>Blogsy</title>
</head>

<body>
  <!--navbar-->
  <nav class="navbar navbar-expand-lg custom-navbar shadow-sm py-3">
    <div class="container-fluid">
      <a class="navbar-brand fs-3 fw-bold text-dark me-4" href="#">Blogsy</a>

      <form class="d-flex me-auto" role="search" method="GET" action="/search" style="width: 35%;">
        <input class="form-control me-2" type="search" name="query" placeholder="Search posts..." aria-label="Search" />
        <button type="submit" class="btn btn-light">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search"
            viewBox="0 0 16 16">
            <path
              d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
          </svg>
        </button>
      </form>


      <ul class="navbar-nav mb-2 mb-lg-0 d-flex flex-row gap-3 me-3">
        <li class="nav-item">
          <a class="nav-link active" href="/"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
              fill="currentColor" class="bi bi-house-heart" viewBox="0 0 16 16">
              <path d="M8 6.982C9.664 5.309 13.825 8.236 8 12 2.175 8.236 6.336 5.309 8 6.982" />
              <path
                d="M8.707 1.5a1 1 0 0 0-1.414 0L.646 8.146a.5.5 0 0 0 .708.707L2 8.207V13.5A1.5 1.5 0 0 0 3.5 15h9a1.5 1.5 0 0 0 1.5-1.5V8.207l.646.646a.5.5 0 0 0 .708-.707L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293zM13 7.207V13.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V7.207l5-5z" />
            </svg>Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/compose"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
              fill="currentColor" class="bi bi-plus-square" viewBox="0 0 16 16">
              <path
                d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2z" />
              <path
                d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4" />
            </svg>Compose</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/about"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
              fill="currentColor" class="bi bi-info-circle-fill" viewBox="0 0 16 16">
              <path
                d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2" />
            </svg>About</a>
        </li>
      </ul>
    </div>
  </nav>

  <!-- Carousel -->
  <div class="container mt-5">
    <div id="carouselExampleCaptions" class="carousel slide">
      <div class="carousel-indicators">
        <% for(let i=0; i < 5; i++) { %>
          <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="<%= i %>"
            class="<%= i === 0 ? 'active' : '' %>" aria-current="<%= i === 0 ? 'true' : '' %>"
            aria-label="Slide <%= i+1 %>"></button>
          <% } %>
      </div>

      <div class="carousel-inner">
        <div class="carousel-item active">
          <img src="/fashion-blog.jpg" class="d-block w-100" alt="fashion" />
          <div class="carousel-caption d-none d-md-block">
            <h5>Saffron and Silk</h5>
            <p>Grace in every thread. Style with soul.</p>
          </div>
        </div>
        <div class="carousel-item">
          <img src="/travel2-blog.jpg" class="d-block w-100" alt="travel" />
          <div class="carousel-caption d-none d-md-block">
            <h5>Rouge Miles</h5>
            <p>Chasing timeless places and quiet magic.</p>
          </div>
        </div>
        <div class="carousel-item">
          <img src="/food-blog.png" class="d-block w-100" alt="food" />
          <div class="carousel-caption d-none d-md-block">
            <h5>Velvet Trails</h5>
            <p>Where cravings meet couture and wild wanderlust.</p>
          </div>
        </div>
        <div class="carousel-item">
          <img src="/animals-blog.jpg" class="d-block w-100" alt="animals" />
          <div class="carousel-caption d-none d-md-block">
            <h5>Paws & Pavé</h5>
            <p>Gentle souls, wild hearts, and soft moments.</p>
          </div>
        </div>
        <div class="carousel-item">
          <img src="/lifestyle-blog.jpg" class="d-block w-100" alt="lifestyle" />
          <div class="carousel-caption d-none d-md-block">
            <h5>Maison Muse</h5>
            <p>Curated calm. Inspired spaces. A lifestyle you love.</p>
          </div>
        </div>
      </div>

      <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleCaptions"
        data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
      </button>
      <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleCaptions"
        data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
      </button>
    </div>
  </div>

  <div class="container mt-5">
    <h2 class="fw-bold fst-italic mb-4 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-leaf-fill"
        viewBox="0 0 16 16">
        <path
          d="M1.4 1.7c.217.289.65.84 1.725 1.274 1.093.44 2.885.774 5.834.528 2.02-.168 3.431.51 4.326 1.556C14.161 6.082 14.5 7.41 14.5 8.5q0 .344-.027.734C13.387 8.252 11.877 7.76 10.39 7.5c-2.016-.288-4.188-.445-5.59-2.045-.142-.162-.402-.102-.379.112.108.985 1.104 1.82 1.844 2.308 2.37 1.566 5.772-.118 7.6 3.071.505.8 1.374 2.7 1.75 4.292.07.298-.066.611-.354.715a.7.7 0 0 1-.161.042 1 1 0 0 1-1.08-.794c-.13-.97-.396-1.913-.868-2.77C12.173 13.386 10.565 14 8 14c-1.854 0-3.32-.544-4.45-1.435-1.124-.887-1.889-2.095-2.39-3.383-1-2.562-1-5.536-.65-7.28L.73.806z" />
      </svg>Latest Posts
    </h2>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
      <% posts.forEach(post=> { %>
        <div class="col">
          <div class="card h-100 shadow-sm border-0 rounded-4">
            <div class="card-body d-flex flex-column">
              <h5 class="card-title fw-bold mb-3">
                <%= post.title %>
              </h5>
              <p class="card-text text-muted flex-grow-1">
                <%= post.content.slice(0, 120) %>...
              </p>
              <div class="d-flex justify-content-between mt-3">
                <a href="/posts/<%= post.id %>" class="btn btn-dark btn-sm">Read More</a>
                <a href="/posts/<%= post.id %>/edit" class="btn btn-dark btn-sm">Edit</a>
                <form action="/posts/<%= post.id %>/delete" method="POST" style="display:inline;">
                  <button type="submit" class="btn btn-dark btn-sm">Delete</button>
                </form>
              </div>
            </div>
          </div>
        </div>
        <% }) %>
    </div>
  </div>
  <footer class="footer mt-5 py-4 text-center text-muted">
    <div class="container">
      <p class="mb-1">© <%= new Date().getFullYear() %> Blogsy — All rights reserved.</p>
      <p class="mb-0">
        Made by <a href="https://yourportfolio.com" class="text-decoration-none text-dark fw-semibold">Sathvika</a>
      </p>
    </div>
  </footer>




  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q"
    crossorigin="anonymous"></script>
</body>

</html>