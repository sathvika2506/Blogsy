<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Blogsy — Your cozy corner of the internet. Read and write stories about fashion, travel, lifestyle, and more." />
  <title>Blogsy — A Warm Place for Stories</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="/style.css" rel="stylesheet" />
</head>
<body>
  <%- include('partials/navbar') %>

  <!-- Hero Carousel -->
  <div class="container mt-4">
    <div id="heroCarousel" class="carousel slide" data-bs-ride="carousel">
      <div class="carousel-indicators">
        <% for(let i=0; i < 5; i++) { %>
          <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="<%= i %>"
            class="<%= i === 0 ? 'active' : '' %>"></button>
        <% } %>
      </div>
      <div class="carousel-inner">
        <div class="carousel-item active">
          <img src="/fashion-blog.jpg" class="d-block w-100" alt="fashion" />
          <div class="carousel-caption"><h5>Saffron and Silk</h5><p>Grace in every thread. Style with soul.</p></div>
        </div>
        <div class="carousel-item">
          <img src="/travel2-blog.jpg" class="d-block w-100" alt="travel" />
          <div class="carousel-caption"><h5>Rouge Miles</h5><p>Chasing timeless places and quiet magic.</p></div>
        </div>
        <div class="carousel-item">
          <img src="/food-blog.png" class="d-block w-100" alt="food" />
          <div class="carousel-caption"><h5>Velvet Trails</h5><p>Where cravings meet couture and wild wanderlust.</p></div>
        </div>
        <div class="carousel-item">
          <img src="/animals-blog.jpg" class="d-block w-100" alt="animals" />
          <div class="carousel-caption"><h5>Paws & Pavé</h5><p>Gentle souls, wild hearts, and soft moments.</p></div>
        </div>
        <div class="carousel-item">
          <img src="/lifestyle-blog.jpg" class="d-block w-100" alt="lifestyle" />
          <div class="carousel-caption"><h5>Maison Muse</h5><p>Curated calm. Inspired spaces. A lifestyle you love.</p></div>
        </div>
      </div>
      <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
      </button>
      <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
      </button>
    </div>
  </div>

  <!-- Latest Posts -->
  <div class="container mt-5">
    <h2 class="section-heading">
      🌸 Latest Stories
    </h2>

    <% if (posts.length === 0) { %>
      <div class="text-center py-5">
        <p style="font-size:3rem;">📖</p>
        <h4>No stories yet.</h4>
        <p class="text-muted">Be the first to share your story!</p>
        <% if (currentUser) { %>
          <a href="/compose" class="btn-primary-warm">Write Your First Post</a>
        <% } else { %>
          <a href="/register" class="btn-primary-warm">Join Blogsy</a>
        <% } %>
      </div>
    <% } else { %>
      <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        <% posts.forEach(post => { %>
          <div class="col">
            <div class="blog-card">
              <% if (post.cover_image) { %>
                <img src="<%= post.cover_image %>" class="card-cover" alt="<%= post.title %>">
              <% } %>
              <div class="card-body">
                <!-- Tags -->
                <% if (post.tags && post.tags.length > 0) { %>
                  <div class="mb-2">
                    <% post.tags.slice(0, 2).forEach(tag => { %>
                      <a href="/search?tag=<%= tag %>" class="tag-badge me-1"><%= tag %></a>
                    <% }) %>
                  </div>
                <% } %>

                <h5 class="card-title">
                  <a href="/posts/<%= post.id %>" style="color:inherit; text-decoration:none; hover:color:var(--primary)">
                    <%= post.title %>
                  </a>
                </h5>
                <p class="card-excerpt"><%= post.content.replace(/[#*`>]/g, '').slice(0, 110) %>...</p>

                <div class="card-footer-custom">
                  <div class="author-mini">
                    <% if (post.author_avatar) { %>
                      <img src="<%= post.author_avatar %>" alt="<%= post.author_name %>" class="author-avatar-sm">
                    <% } else { %>
                      <div class="author-placeholder-sm">
                        <%= post.author_name ? post.author_name.charAt(0).toUpperCase() : 'A' %>
                      </div>
                    <% } %>
                    <span class="author-name-sm"><%= post.author_name || 'Anonymous' %></span>
                  </div>
                  <div class="d-flex gap-2 align-items-center">
                    <span class="stat-badge">❤️ <%= post.like_count || 0 %></span>
                    <span class="stat-badge">💬 <%= post.comment_count || 0 %></span>
                    <a href="/posts/<%= post.id %>" class="btn-sm-warm">Read</a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <!-- CTA Banner (for non-logged users) -->
  <% if (!currentUser) { %>
  <div class="container mt-5">
    <div style="background: linear-gradient(135deg, #F2C4B0, #EBB5A8); border-radius: var(--radius-lg); padding: 3rem 2rem; text-align:center;">
      <h3 style="font-family:'Playfair Display',serif; font-size:1.8rem; margin-bottom:0.5rem;">Start Your Story Today</h3>
      <p class="text-muted mb-3">Join thousands of writers sharing their world on Blogsy.</p>
      <a href="/register" class="btn-primary-warm me-2">Join for Free</a>
      <a href="/login" class="btn-outline-warm">Sign In</a>
    </div>
  </div>
  <% } %>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>